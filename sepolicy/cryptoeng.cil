;; cryptoeng HAL domain, merged into /vendor/etc/selinux/vendor_sepolicy.cil.
;; Platform types carry the 202404 mapping suffix (vendor API level 202404).
;; ---- cryptoeng ----
(type hal_cryptoeng_oplus)
(roletype object_r hal_cryptoeng_oplus)
(type hal_cryptoeng_oplus_exec)
(roletype object_r hal_cryptoeng_oplus_exec)
(type hal_cryptoeng_service)
(roletype object_r hal_cryptoeng_service)
(typeattributeset domain (hal_cryptoeng_oplus))
(typeattributeset halserverdomain (hal_cryptoeng_oplus))
(typeattributeset hal_cryptoeng (hal_cryptoeng_oplus))
(typeattributeset hal_cryptoeng_server (hal_cryptoeng_oplus))
(typeattributeset file_type (hal_cryptoeng_oplus_exec))
(typeattributeset exec_type (hal_cryptoeng_oplus_exec))
(typeattributeset vendor_file_type (hal_cryptoeng_oplus_exec))
(typeattributeset protected_service (hal_cryptoeng_service))
(typeattributeset service_manager_type (hal_cryptoeng_service))
(typeattributeset hal_service_type (hal_cryptoeng_service))
(typetransition init_202404 hal_cryptoeng_oplus_exec process hal_cryptoeng_oplus)
(allow init_202404 hal_cryptoeng_oplus_exec (file (read getattr map execute open)))
(allow init_202404 hal_cryptoeng_oplus (process (transition)))
(allow init_202404 hal_cryptoeng_oplus (process (siginh rlimitinh)))
(dontaudit init_202404 hal_cryptoeng_oplus (process (noatsecure)))
(allow hal_cryptoeng_oplus hal_cryptoeng_oplus_exec (file (read getattr map execute open entrypoint)))
(allow hal_cryptoeng_oplus binder_device_202404 (chr_file (ioctl read write map open)))
(allow hal_cryptoeng_oplus servicemanager_202404 (binder (call transfer)))
(allow servicemanager_202404 hal_cryptoeng_oplus (binder (call transfer)))
(allow servicemanager_202404 hal_cryptoeng_oplus (dir (search)))
(allow servicemanager_202404 hal_cryptoeng_oplus (file (read open)))
(allow servicemanager_202404 hal_cryptoeng_oplus (process (getattr)))
(allow hal_cryptoeng_oplus hal_cryptoeng_service (service_manager (add find)))
(allow hal_cryptoeng_client hal_cryptoeng_service (service_manager (find)))
(allow hal_cryptoeng_client hal_cryptoeng_server (binder (call transfer)))
(allow hal_cryptoeng_server hal_cryptoeng_client (binder (call transfer)))
(allow hal_cryptoeng_client hal_cryptoeng_server (fd (use)))
(allow hal_cryptoeng_server hal_cryptoeng_client (fd (use)))
(allow hal_cryptoeng_oplus vendor_file_202404 (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_cryptoeng_oplus vendor_file_202404 (file (read getattr map execute open)))
(allow hal_cryptoeng_oplus same_process_hal_file_202404 (file (read getattr map execute open)))
(allow hal_cryptoeng_oplus property_socket_202404 (sock_file (write)))
(allow hal_cryptoeng_oplus init_202404 (unix_stream_socket (connectto)))
(allow hal_cryptoeng_oplus exported_system_prop_202404 (file (read getattr map open)))
(allow hal_cryptoeng_oplus vendor_default_prop_202404 (file (read getattr map open)))
(allow hal_cryptoeng_oplus bootloader_prop_202404 (file (read getattr map open)))
(type vendor_cryptoeng_data_file)
(roletype object_r vendor_cryptoeng_data_file)
(typeattributeset file_type (vendor_cryptoeng_data_file))
(typeattributeset data_file_type (vendor_cryptoeng_data_file))
(allow hal_cryptoeng_oplus vendor_data_file_202404 (dir (search getattr)))
(allow hal_cryptoeng_oplus vendor_cryptoeng_data_file (dir (read write open getattr search add_name remove_name)))
(allow hal_cryptoeng_oplus vendor_cryptoeng_data_file (file (create read write open getattr lock rename unlink)))
(allow init_202404 vendor_cryptoeng_data_file (dir (create read write open search getattr setattr relabelfrom relabelto add_name remove_name)))
(allow init_202404 vendor_cryptoeng_data_file (file (read open getattr setattr relabelfrom relabelto)))
